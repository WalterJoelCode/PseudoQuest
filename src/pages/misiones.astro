---
import AppLayout from '../layouts/AppLayout.astro';import{levels,allMissions}from'../data/course';const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
---
<AppLayout title="Misiones"><div class="container"><header class="page-head"><p class="eyebrow">Tu aventura</p><h1>Misiones</h1><p>15 juegos disponibles en tres niveles. Tu mejor resultado y cada actividad terminada quedan guardados.</p><div class="progress"><span data-bar></span></div><small><b data-count>0</b> de 15 completadas</small></header><section class="levels">{levels.slice(0,3).map(level=><article class="level-card" style={`--level:${level.color}`}><div class="level-icon">{level.icon}</div><div class="level-copy"><span class="tag">Nivel {level.id} · {level.name}</span><h3>{level.title}</h3><p>{level.description}</p></div><div class="mission-list">{level.missions.map((m,i)=><a href={`${base}mision/${m.id}`} data-id={m.id}><span class="mission-number">{i+1}</span><div><b>{m.title}</b><small>8 preguntas · hasta {m.xp} XP</small></div><strong class="mission-state"><i data-score>—</i><em data-status>Sin realizar</em></strong></a>)}</div></article>)}{levels.slice(3).map(level=><article class="level-card upcoming" style={`--level:${level.color}`}><div class="level-icon">🔒</div><div class="level-copy"><span class="tag">Nivel {level.id} · {level.name}</span><h3>{level.title}</h3><p>{level.description}</p></div><div class="development"><span>🚧 Próximamente</span><b>En desarrollo</b><p>Estamos preparando cinco nuevos juegos para continuar la aventura.</p></div></article>)}</section></div>
<script is:inline define:vars={{ids:allMissions.map(x=>x.id)}}>function renderMissions(){const s=window.PQ.read(),done=s.completed||[],scores=s.bestScores||{};document.querySelector('[data-count]').textContent=done.length;document.querySelector('[data-bar]').style.width=`${done.length/ids.length*100}%`;document.querySelectorAll('[data-id]').forEach(card=>{const id=card.dataset.id,isDone=done.includes(id);card.classList.toggle('done',isDone);card.querySelector('[data-score]').textContent=scores[id]==null?'—':scores[id]+'/8';card.querySelector('[data-status]').textContent=isDone?'✓ Realizada':'Sin realizar';card.setAttribute('aria-label',`${card.querySelector('b').textContent}. ${isDone?'Realizada':'Sin realizar'}`)})}function initMissions(){renderMissions();addEventListener('pq:update',renderMissions)}if(window.PQ)initMissions();else addEventListener('pq:ready',initMissions,{once:true})</script></AppLayout>
<style>.page-head{max-width:740px}.page-head .progress{margin:22px 0 8px}.level-card{grid-template-columns:70px 230px 1fr;align-items:start}.mission-list{display:grid;gap:9px}.mission-list>a{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--bg);transition:.2s}.mission-list>a:hover{border-color:var(--level);transform:translateY(-1px)}.mission-number{width:36px;height:36px;border-radius:10px;background:var(--surface-2);display:grid;place-items:center;font-weight:800}.mission-list>a.done{border-color:color-mix(in srgb,var(--level) 42%,var(--line));background:color-mix(in srgb,var(--level) 7%,var(--surface))}.mission-list>a.done .mission-number{background:var(--level);color:#fff}.mission-list b,.mission-list small,.mission-state i,.mission-state em{display:block}.mission-list small{color:var(--muted);font-size:11px}.mission-state{text-align:right}.mission-state i{font-style:normal;color:var(--muted);font-size:12px}.mission-state em{font-style:normal;color:var(--muted);font-size:10px}.mission-list>a.done .mission-state em{color:var(--level);font-weight:800}.upcoming{opacity:.72;box-shadow:none;border-style:dashed;align-items:center}.development{justify-self:stretch;padding:17px;border-radius:15px;background:var(--surface-2)}.development span,.development b{display:block}.development span{color:#d58c17;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.development p{margin:5px 0 0;color:var(--muted);font-size:12px}@media(max-width:850px){.level-card{grid-template-columns:55px 1fr}.mission-list,.development{grid-column:1/-1}}</style>
