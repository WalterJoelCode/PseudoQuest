---
import AppLayout from '../layouts/AppLayout.astro';import{levels,allMissions}from'../data/course';const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
---
<AppLayout title="Mapa de recuperación"><div class="container"><header class="page-head"><p class="eyebrow">MAPA DE SISTEMAS // COLONIA KEPLER</p><h1>Misiones</h1><p>15 archivos distribuidos en tres sectores. Restaura los cinco módulos de cada sector para autorizar el acceso al siguiente.</p><div class="progress"><span data-bar></span></div><small><b data-count>0</b> de 15 archivos recuperados</small></header><section class="levels">
{levels.slice(0,3).map(level=><article class="level-card" data-level={level.id} data-icon={level.icon} style={`--level:${level.color}`}><div class="level-icon" data-level-icon>{level.icon}</div><div class="level-copy"><span class="tag">Nivel {level.id} · {level.name}</span><h3>{level.title}</h3><p>{level.description}</p><small class="level-requirement" data-level-requirement></small></div><div class="mission-list">{level.missions.map((m,i)=><a href={`${base}mision/${m.id}`} data-id={m.id} data-mission-level={level.id}><span class="mission-number">{i+1}</span><div><b>{m.title}</b><small>8 preguntas · hasta {m.xp} XP</small></div><strong class="mission-state"><i data-score>—</i><em data-status>Sin realizar</em></strong></a>)}</div></article>)}
{levels.slice(3).map(level=><article class="level-card upcoming" style={`--level:${level.color}`}><div class="level-icon">🔒</div><div class="level-copy"><span class="tag">Nivel {level.id} · {level.name}</span><h3>{level.title}</h3><p>{level.description}</p></div><div class="development"><span>🚧 Próximamente</span><b>En desarrollo</b><p>Estamos preparando cinco nuevos juegos para continuar la aventura.</p></div></article>)}
<article class="level-card recognition" aria-disabled="true"><div class="level-icon">🏅</div><div class="level-copy"><span class="tag">Meta final</span><h3>Reconocimiento</h3><p>Completa todos los juegos de los cinco niveles para obtenerlo.</p></div><div class="development"><span>🔒 Inhabilitado</span><b>Aún no disponible</b><p>Se habilitará cuando los 25 juegos estén disponibles y completados.</p></div></article>
</section></div>
<script is:inline define:vars={{ids:allMissions.map(x=>x.id)}}>
function renderMissions(){const s=window.PQ.read(),done=s.completed||[],scores=s.bestScores||{};document.querySelector('[data-count]').textContent=done.length;document.querySelector('[data-bar]').style.width=`${done.length/ids.length*100}%`;document.querySelectorAll('[data-level]').forEach(card=>{const level=Number(card.dataset.level),firstId=`${level}-1`,firstIndex=ids.indexOf(firstId),locked=firstIndex>0&&!done.includes(ids[firstIndex-1])&&!done.includes(firstId);card.classList.toggle('locked',locked);card.querySelector('[data-level-icon]').textContent=locked?'🔒':card.dataset.icon;card.querySelector('[data-level-requirement]').textContent=locked?`Completa la misión anterior para autorizar el sector ${level}.`:''});document.querySelectorAll('[data-id]').forEach(card=>{const id=card.dataset.id,index=ids.indexOf(id),isDone=done.includes(id),locked=!isDone&&index>0&&!done.includes(ids[index-1]);card.classList.toggle('done',isDone);card.classList.toggle('locked',locked);card.setAttribute('aria-disabled',String(locked));card.tabIndex=locked?-1:0;card.querySelector('[data-score]').textContent=scores[id]==null?'—':scores[id]+'/8';card.querySelector('[data-status]').textContent=locked?'REQUIERE ARCHIVO ANTERIOR':isDone?'CONOCIMIENTO RECUPERADO':'SIGUIENTE MISIÓN';card.onclick=locked?event=>{event.preventDefault();window.PQ.toast('Secuencia bloqueada: completa la misión anterior')}:null})}
function initMissions(){renderMissions();addEventListener('pq:update',renderMissions)}if(window.PQ)initMissions();else addEventListener('pq:ready',initMissions,{once:true})
</script></AppLayout>
<style>.page-head{max-width:740px}.page-head .progress{margin:22px 0 8px}.level-card{grid-template-columns:70px 230px 1fr;align-items:start}.mission-list{display:grid;gap:9px}.mission-list>a{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--bg);transition:.2s}.mission-list>a:hover{border-color:var(--level);transform:translateY(-1px)}.mission-number{width:36px;height:36px;border-radius:10px;background:var(--surface-2);display:grid;place-items:center;font-weight:800}.mission-list>a.done{border-color:color-mix(in srgb,var(--level) 42%,var(--line));background:color-mix(in srgb,var(--level) 7%,var(--surface))}.mission-list>a.done .mission-number{background:var(--level);color:#fff}.mission-list b,.mission-list small,.mission-state i,.mission-state em{display:block}.mission-list small{color:var(--muted);font-size:11px}.mission-state{text-align:right}.mission-state i{font-style:normal;color:var(--muted);font-size:12px}.mission-state em{font-style:normal;color:var(--muted);font-size:10px}.mission-list>a.done .mission-state em{color:var(--level);font-weight:800}.level-card.locked{opacity:.68}.mission-list>a.locked{cursor:not-allowed;background:var(--surface-2);filter:saturate(.3)}.level-requirement{display:block;margin-top:10px;color:#b46d14;font-weight:750}.upcoming{opacity:.72;box-shadow:none;border-style:dashed;align-items:center}.development{justify-self:stretch;padding:17px;border-radius:15px;background:var(--surface-2)}.development span,.development b{display:block}.development span{color:#d58c17;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.development p{margin:5px 0 0;color:var(--muted);font-size:12px}.recognition{margin-top:28px;border:2px dashed color-mix(in srgb,#e7b93f 55%,var(--line));background:linear-gradient(135deg,color-mix(in srgb,#e7b93f 8%,var(--surface)),var(--surface));opacity:.7}@media(max-width:850px){.level-card{grid-template-columns:55px 1fr}.mission-list,.development{grid-column:1/-1}}</style>
