---
import AppLayout from '../layouts/AppLayout.astro';
import { allMissions } from '../data/course';
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
const missionData=allMissions.map(({id,title})=>({id,title}));
---
<AppLayout title="Centro de operaciones"><div class="container ops"><section class="hero welcome"><div><p class="eyebrow">ARCHIVO KEPLER // ACCESO AUTORIZADO</p><h1>El futuro necesita <span>Reconstructores</span></h1><p>La colonia conserva la tecnología de la Tierra, pero perdió el conocimiento para mantenerla. Tu entrenamiento comienza en la lógica: cada algoritmo recuperado restaura una parte del futuro.</p><div class="hero-actions"><a class="button" data-primary-mission href={`${base}misiones`}>RECUPERAR SIGUIENTE ARCHIVO →</a><a class="button secondary" href={`${base}progreso`}>VER RECONSTRUCCIÓN</a></div></div><aside class="hero-card identity"><p class="eyebrow">RECONSTRUCTOR // ACTIVE</p><strong data-profile-alias>Reconstructor</strong><small>NIVEL DE RECONSTRUCCIÓN</small><b data-level-name>Archivo Cero</b><div class="progress"><span data-home-bar></span></div><footer><span><i data-home-percent>0</i>% recuperado</span><span><i data-xp>0</i> XP</span></footer></aside></section><section class="ops-grid"><article class="card op-card"><p class="eyebrow">TRANSMISIÓN ACTUAL</p><h2 data-next-title>Preparando enlace...</h2><p data-next-copy>El siguiente fragmento de conocimiento está listo para recuperarse.</p><a data-next-link href={`${base}misiones`}>ABRIR ARCHIVO →</a></article><article class="card metrics"><div><small>CONOCIMIENTO</small><strong><i data-xp>0</i> XP</strong></div><div><small>ARCHIVOS</small><strong><i data-home-done>0</i> / 15</strong></div><div><small>RACHA</small><strong><i data-streak>1</i> DÍAS</strong></div></article></section><section class="purpose"><article><span>⌬</span><h2>Analiza</h2><p>Comprende el sistema y reconoce sus patrones.</p></article><article><span>⌘</span><h2>Reconstruye</h2><p>Resuelve transmisiones con feedback inmediato.</p></article><article><span>◇</span><h2>Restaura</h2><p>Convierte cada misión en conocimiento recuperado.</p></article></section><blockquote>“Los sistemas pueden olvidarse. La lógica puede reconstruirlos.”</blockquote></div>
<script is:inline define:vars={{missions:missionData}}>function renderOps(){const state=window.PQ.read(),done=state.completed||[],percent=Math.round(done.length/missions.length*100),next=missions.find(m=>!done.includes(m.id));document.querySelector('[data-home-percent]').textContent=percent;document.querySelector('[data-home-bar]').style.width=percent+'%';document.querySelector('[data-home-done]').textContent=done.length;document.querySelector('[data-level-name]').textContent=done.length>=10?'Motor de Automatización':done.length>=5?'Núcleo de Datos':'Archivo Cero';document.querySelector('[data-next-title]').textContent=next?next.title:'SISTEMAS DISPONIBLES RESTAURADOS';document.querySelector('[data-next-copy]').textContent=next?'Archivo listo para recuperación. Conserva intacta la secuencia lógica.':'Las 15 misiones disponibles han sido recuperadas.';const href=(window.PQ_BASE||'/')+(next?'mision/'+next.id:'progreso');document.querySelector('[data-next-link]').href=href;document.querySelector('[data-primary-mission]').href=href}function initOps(){renderOps();addEventListener('pq:update',renderOps)}if(window.PQ)initOps();else addEventListener('pq:ready',initOps,{once:true});</script></AppLayout>
<style>.welcome{min-height:540px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.identity{display:grid;gap:10px}.identity strong{font-size:30px}.identity small{color:var(--muted);font:700 10px ui-monospace,monospace;letter-spacing:.12em}.identity>b{font-size:17px;color:var(--accent)}.identity footer{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.ops-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:16px;margin-bottom:16px}.op-card{padding:26px}.op-card h2{margin:5px 0}.op-card p{color:var(--muted)}.op-card>a{color:var(--accent);font:800 12px ui-monospace,monospace}.metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:20px}.metrics>div{padding:12px;border-right:1px solid var(--line)}.metrics>div:last-child{border:0}.metrics small,.metrics strong{display:block}.metrics small{color:var(--muted);font:700 9px ui-monospace,monospace}.metrics strong{margin-top:8px}.metrics i{font-style:normal}.purpose{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:16px 0 30px}.purpose article{padding:24px;border:1px solid var(--line);background:var(--surface)}.purpose p{color:var(--muted)}.ops blockquote{margin:0 0 70px;padding:24px;border-left:2px solid var(--accent);color:var(--muted);font-size:18px}@media(max-width:720px){.ops-grid,.purpose{grid-template-columns:1fr}.metrics{grid-template-columns:1fr}.metrics>div{border-right:0;border-bottom:1px solid var(--line)}}</style>
