---
import AppLayout from '../layouts/AppLayout.astro';
import { levels } from '../data/course';
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
const url=(value:string)=>`${base}${value.replace(/^\//,'')}`;
---
<AppLayout title="Tu aventura comienza aquí">
<div class="container">
  <section class="hero"><div><p class="eyebrow">Aprende · Practica · Domina</p><h1>Convierte la lógica en tu <span>superpoder</span></h1><p>Misiones breves, retos prácticos y feedback al instante. Construye las bases para crear tus propios algoritmos en PSeInt.</p><a class="button" id="continue" href={url('/mision/1-1')}>Continuar aventura <span>→</span></a></div><aside class="hero-card"><p class="eyebrow">Tu rango actual</p><strong data-rank>Novato</strong><p><span data-complete-count>0</span> de 15 misiones completadas</p><div class="progress"><span data-total-bar style="width:0%"></span></div><p><b data-xp>0</b> XP acumulados · siguiente rango a 100 XP</p></aside></section>
  <section class="daily"><div class="daily-icon">🔥</div><div><p class="eyebrow">Reto del día · +10 XP</p><h3>Detecta la salida</h3><p>Si x ← 4 y luego x ← x * 2, ¿qué valor se escribe?</p></div><button class="button secondary" id="daily-btn">Responder: 8</button></section>
  <div class="section-title"><div><h2>Tu ruta de aprendizaje</h2><p>Completa las misiones en orden y desbloquea nuevos rangos.</p></div><span class="pill"><span data-complete-count>0</span>/15 completadas</span></div>
  <section class="levels">
  {levels.map((level)=><article class:list={['level-card',{locked:level.locked}]} style={`--level:${level.color}`} data-level={level.id}>
    <div class="level-icon">{level.locked?'🔒':level.icon}</div><div class="level-copy"><span class="tag">Nivel {level.id} · {level.name}</span><h3>{level.title}</h3><p>{level.description}</p></div>
    <div class="mission-dots">{level.locked ? <><span class="pill">Próximamente</span><span>Vectores</span><span>·</span><span>Matrices</span><span>·</span><span>Funciones</span></> : level.missions.map((item,i)=><a class="mission-dot" href={url(`/mision/${item.id}`)} data-mission={item.id} aria-label={`Misión ${i+1}: ${item.title}`}>{i+1}</a>)}</div>
    <div class="level-action">{level.locked?<span class="pill">🔒 Próximamente</span>:<a class="button secondary" data-level-link={level.id} href={url(`/mision/${level.missions[0].id}`)}>Empezar →</a>}</div>
  </article>)}
  </section>
</div>
<script is:inline define:vars={{base}}>
const all=["1-1","1-2","1-3","1-4","1-5","2-1","2-2","2-3","2-4","2-5","3-1","3-2","3-3","3-4","3-5"];
function render(){const s=window.PQ.read(),done=s.completed;const next=all.find(id=>!done.includes(id))||'3-5';document.querySelector('#continue').href=base+'mision/'+next;document.querySelectorAll('[data-complete-count]').forEach(e=>e.textContent=done.length);document.querySelector('[data-total-bar]').style.width=(done.length/15*100)+'%';document.querySelector('[data-rank]').textContent=s.xp>=200?'Developer':s.xp>=100?'Junior':'Novato';document.querySelectorAll('[data-mission]').forEach(e=>{const id=e.dataset.mission,idx=all.indexOf(id);e.classList.toggle('done',done.includes(id));e.classList.toggle('current',id===next);if(idx>0&&!done.includes(all[idx-1])){e.style.pointerEvents='none';e.style.opacity='.4'}});[1,2,3].forEach(l=>{const ids=all.filter(x=>x.startsWith(l+'-')),n=ids.find(x=>!done.includes(x))||ids[4],a=document.querySelector(`[data-level-link="${l}"]`);if(a){a.href=base+'mision/'+n;a.textContent=ids.every(x=>done.includes(x))?'Repasar →':done.some(x=>ids.includes(x))?'Continuar →':'Empezar →'}})}render();window.addEventListener('pq:update',render);
document.querySelector('#daily-btn').addEventListener('click',e=>{const s=window.PQ.read(),key='daily-'+new Date().toISOString().slice(0,10);if(s[key])return window.PQ.toast('Reto de hoy ya completado');s[key]=true;s.xp+=10;window.PQ.save(s);window.PQ.tone('win');e.currentTarget.textContent='✓ Completado';window.PQ.toast('¡Reto resuelto! +10 XP')});
</script>
</AppLayout>
