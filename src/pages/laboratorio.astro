---
import AppLayout from '../layouts/AppLayout.astro';
import {labExercises,labLevels} from '../data/laboratory';
---
<style is:global>.order-bank button i:empty::before{content:'↕';color:var(--muted)}</style>
<style is:global>.hint-box.is-hidden{display:none!important}@media(max-width:760px){.challenge-actions{position:sticky;bottom:-20px;z-index:3;padding:16px 0 4px;background:linear-gradient(180deg,transparent,var(--surface) 22%)}}</style>
<style is:global>.hint-box[hidden],.challenge-feedback[hidden]{display:none!important}body:has(.lab-page) .progress-fab{display:none}@media(max-width:760px){.challenge-modal{width:calc(100% - 18px);max-height:calc(100dvh - 18px)}.challenge-top{padding:18px 62px 16px 20px}.challenge-body{padding:20px}.choice span,.order-bank button{min-height:52px;padding:13px 14px}.challenge-prompt{margin-top:18px}.hint-box,.challenge-feedback{margin-block:16px}.challenge-actions{gap:12px}}</style>
<AppLayout title="Laboratorio de lógica"><div class="lab-page">
<section class="lab-hero"><div class="container lab-hero-grid"><div><p class="eyebrow">Capítulo II · La red fragmentada</p><h1>Laboratorio de <span>lógica</span></h1><p>Treinta anomalías bloquean el Núcleo de PseudoQuest. Analiza, ordena y repara pseudocódigo para devolverle estabilidad a la ciudad digital.</p><div class="lab-stats"><span>⚡ <b data-lab-xp>0</b> XP de laboratorio</span><span>✓ <b data-lab-count>0</b>/30 reparaciones</span><span>🔥 XP por rapidez</span></div></div><aside class="terminal-card"><div><i></i><i></i><i></i><small>SISTEMA // ESTADO</small></div><pre data-terminal>&gt; Red detectada{String.fromCharCode(10)}&gt; 30 anomalías localizadas{String.fromCharCode(10)}&gt; Esperando operador...</pre><div class="lab-progress"><span data-lab-bar></span></div></aside></div></section>
<main class="container lab-map">{labLevels.map(level=><section class="lab-zone" data-zone={level.id} style={`--zone:${level.color}`}><header><div class="zone-emblem">{level.icon}</div><div><p>Nivel {level.id} · {level.chapter}</p><h2>{level.name}</h2><span>{level.intro}</span></div><strong><i data-zone-count={level.id}>0</i>/10</strong></header><div class="path">{labExercises.filter(x=>x.level===level.id).map((exercise,index)=><div class="path-stop" data-stop={exercise.id}><button class="lab-node" data-open={exercise.id} aria-label={`Abrir desafío ${index+1}: ${exercise.title}`}><i>{index+1}</i><em>🔒</em></button><article><small>{exercise.type==='order'?'Ordenamiento':exercise.type==='fill'?'Completar código':'Análisis lógico'}</small><h3>{exercise.title}</h3><p>{exercise.story}</p><span data-stop-state>Bloqueado</span></article></div>)}</div></section>)}</main></div>
<dialog class="challenge-modal" data-challenge aria-labelledby="challenge-title"><button class="challenge-close" data-close aria-label="Cerrar">×</button><div class="challenge-top"><span data-level-label></span><strong>⏱ <i data-timer>0</i>s</strong></div><div class="challenge-body"><p class="eyebrow" data-kind></p><h2 id="challenge-title" data-title></h2><p data-story></p><div class="challenge-prompt" data-prompt></div><pre data-code hidden></pre><div class="challenge-answer" data-answer></div><div class="hint-box is-hidden" data-hint-box hidden><span>💡</span><p data-hint></p></div><div class="challenge-feedback" data-feedback hidden></div><div class="challenge-actions"><button class="button secondary" data-use-hint>Usar pista · −8 XP</button><button class="button" data-submit>Comprobar reparación</button></div></div></dialog>
<script is:inline define:vars={{exercises:labExercises}}>
// @ts-nocheck
let current=null,startTime=0,timer=null,usedHint=false,wrong=0,orderSelection=[],music=null,playlist=[],trackIndex=-1;const modal=document.querySelector('[data-challenge]'),answerBox=document.querySelector('[data-answer]');const stateOf=()=>window.PQ.read();
function renderMap(){const state=stateOf(),done=state.labCompleted||[],scores=state.labScores||{};document.querySelector('[data-lab-count]').textContent=done.length;document.querySelector('[data-lab-xp]').textContent=state.labXp||0;document.querySelector('[data-lab-bar]').style.width=`${done.length/30*100}%`;document.querySelectorAll('[data-zone-count]').forEach(el=>el.textContent=done.filter(id=>id.startsWith(`lab-${el.dataset.zoneCount}-`)).length);exercises.forEach((exercise,index)=>{const stop=document.querySelector(`[data-stop="${exercise.id}"]`),node=stop.querySelector('.lab-node'),isDone=done.includes(exercise.id),unlocked=index===0||done.includes(exercises[index-1].id);stop.classList.toggle('done',isDone);stop.classList.toggle('unlocked',unlocked);node.disabled=!unlocked;node.querySelector('em').textContent=isDone?'✓':unlocked?'▶':'🔒';stop.querySelector('[data-stop-state]').textContent=isDone?`Completado · ${scores[exercise.id]||0} XP`:unlocked?'Disponible':'Bloqueado'});document.querySelector('[data-terminal]').textContent=done.length===30?'> Núcleo restaurado\n> Red estable\n> Operador certificado':`> Red conectada\n> ${30-done.length} anomalías pendientes\n> Progreso guardado`}
function drawExercise(exercise){current=exercise;usedHint=false;wrong=0;orderSelection=[];startTime=Date.now();clearInterval(timer);timer=setInterval(()=>document.querySelector('[data-timer]').textContent=Math.floor((Date.now()-startTime)/1000),250);document.querySelector('[data-timer]').textContent='0';document.querySelector('[data-level-label]').textContent=`Nivel ${exercise.level} · Desafío ${exercise.id.split('-').at(-1)}`;document.querySelector('[data-kind]').textContent=exercise.type==='order'?'Ordena el pseudocódigo':exercise.type==='fill'?'Completa la instrucción':'Diagnóstico lógico';document.querySelector('[data-title]').textContent=exercise.title;document.querySelector('[data-story]').textContent=exercise.story;document.querySelector('[data-prompt]').textContent=exercise.prompt;const code=document.querySelector('[data-code]');code.hidden=!exercise.code;code.textContent=exercise.code||'';document.querySelector('[data-hint]').textContent=exercise.hint;document.querySelector('[data-hint-box]').hidden=true;document.querySelector('[data-feedback]').hidden=true;document.querySelector('[data-use-hint]').disabled=false;document.querySelector('[data-submit]').disabled=false;answerBox.innerHTML='';if(exercise.type==='choice')exercise.options.forEach((label,i)=>answerBox.insertAdjacentHTML('beforeend',`<label class="choice"><input type="radio" name="lab-answer" value="${i}"><span><b>${String.fromCharCode(65+i)}</b>${label}</span></label>`));else if(exercise.type==='fill')answerBox.innerHTML='<label class="fill-answer"><span>Tu respuesta</span><input data-fill autocomplete="off" spellcheck="false" placeholder="Escribe la palabra o valor"></label>';else{answerBox.innerHTML='<div class="order-bank" data-order-bank></div><p class="order-note">Selecciona cada línea en el orden correcto.</p>';exercise.options.forEach((label,i)=>{const button=document.createElement('button');button.dataset.order=String(i);button.innerHTML=`<i></i><code>${label}</code>`;button.onclick=()=>pickOrder(button,i);answerBox.querySelector('[data-order-bank]').appendChild(button)})}modal.showModal();startMusic()}
function pickOrder(button,index){if(button.classList.contains('selected')){orderSelection.splice(orderSelection.indexOf(index),1);button.classList.remove('selected')}else{orderSelection.push(index);button.classList.add('selected')}answerBox.querySelectorAll('[data-order]').forEach(btn=>{const pos=orderSelection.indexOf(Number(btn.dataset.order));btn.querySelector('i').textContent=pos<0?'':pos+1})}
const normalized=value=>String(value).trim().toLocaleLowerCase('es').replace(/\s+/g,' ');
function submit(){if(!current)return;let response=current.type==='choice'?answerBox.querySelector('input:checked')?.value:current.type==='fill'?answerBox.querySelector('[data-fill]').value:orderSelection.join(',');if(response==null||response===''){window.PQ.toast('Selecciona o escribe una respuesta');return}const correct=current.type==='choice'?Number(response)===current.answer:normalized(response)===normalized(current.answer),feedback=document.querySelector('[data-feedback]');feedback.hidden=false;if(!correct){wrong++;feedback.className='challenge-feedback bad';feedback.innerHTML='<b>La anomalía continúa</b><p>Revísalo e inténtalo de nuevo. Este intento reduce 5 XP.</p>';window.PQ.tone('bad');return}clearInterval(timer);const seconds=Math.floor((Date.now()-startTime)/1000),earned=Math.max(5,35-Math.min(15,Math.floor(seconds/5))-(usedHint?8:0)-wrong*5),state=stateOf(),done=state.labCompleted||[],previous=(state.labScores||{})[current.id]||0,delta=done.includes(current.id)?Math.max(0,earned-previous):earned,currentId=current.id;state.labCompleted=[...new Set([...done,currentId])];state.labScores={...(state.labScores||{}),[currentId]:Math.max(previous,earned)};state.labXp=(state.labXp||0)+delta;state.xp=(state.xp||0)+delta;window.PQ.save(state);feedback.className='challenge-feedback good';feedback.innerHTML=`<b>✓ Reparación completada · +${delta} XP</b><p>${current.explanation}</p><small>${seconds}s · ${usedHint?'con pista':'sin pistas'} · ${wrong} intentos fallidos</small>`;document.querySelector('[data-submit]').disabled=true;document.querySelector('[data-use-hint]').disabled=true;window.PQ.tone('win');renderMap();setTimeout(()=>{modal.close();const next=exercises[exercises.findIndex(x=>x.id===currentId)+1];if(next)document.querySelector(`[data-stop="${next.id}"]`)?.scrollIntoView({behavior:'smooth',block:'center'})},2400)}
async function startMusic(change=false){try{if(music&&!change)return;if(!playlist.length)playlist=await fetch((window.PQ_BASE||'/')+'music/tracks.json').then(r=>r.json());if(!playlist.length)return;let next=Math.floor(Math.random()*playlist.length);if(change&&playlist.length>1)while(next===trackIndex)next=Math.floor(Math.random()*playlist.length);trackIndex=next;if(music){music.pause();music.src=''}music=new Audio((window.PQ_BASE||'/')+'music/'+playlist[trackIndex]);music.loop=true;music.volume=stateOf().musicVolume;await music.play();window.PQ_MUSIC_ACTIVE=true;dispatchEvent(new Event('pq:music-state'))}catch{}}
function stopMusic(){if(music){music.pause();music.src='';music=null}window.PQ_MUSIC_ACTIVE=false;dispatchEvent(new Event('pq:music-state'))}
function shuffleOrderExercise(){if(current?.type!=='order')return;const bank=answerBox.querySelector('[data-order-bank]'),buttons=[...bank.children];for(let i=buttons.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));bank.appendChild(buttons[j]);buttons.splice(j,1)}}
document.querySelectorAll('[data-open]').forEach(button=>button.addEventListener('click',()=>{document.querySelector('[data-hint-box]').classList.add('is-hidden');setTimeout(shuffleOrderExercise,0)}));document.querySelector('[data-use-hint]').addEventListener('click',()=>document.querySelector('[data-hint-box]').classList.remove('is-hidden'));
document.querySelectorAll('[data-open]').forEach(button=>button.addEventListener('click',()=>drawExercise(exercises.find(x=>x.id===button.dataset.open))));document.querySelector('[data-submit]').addEventListener('click',submit);document.querySelector('[data-use-hint]').addEventListener('click',()=>{usedHint=true;document.querySelector('[data-hint-box]').hidden=false;document.querySelector('[data-use-hint]').disabled=true;window.PQ.tone('ok')});document.querySelector('[data-close]').addEventListener('click',()=>modal.close());modal.addEventListener('close',()=>{clearInterval(timer);current=null});modal.addEventListener('click',event=>{if(event.target===modal)modal.close()});addEventListener('pq:music-volume',event=>{if(music)music.volume=event.detail});addEventListener('pq:music-next',()=>{if(window.PQ_MUSIC_ACTIVE)startMusic(true)});addEventListener('pagehide',stopMusic);addEventListener('pq:update',renderMap);if(window.PQ)renderMap();else addEventListener('pq:ready',renderMap,{once:true});
</script></AppLayout>
<style is:global>
.lab-page{min-height:100vh;background:radial-gradient(circle at 15% 5%,color-mix(in srgb,var(--purple) 10%,transparent),transparent 420px)}.lab-hero{padding:60px 0 45px;border-bottom:1px solid var(--line)}.lab-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:50px;align-items:center}.lab-hero h1{font-size:clamp(40px,6vw,68px);line-height:1;margin:0 0 20px;letter-spacing:-.05em}.lab-hero h1 span{color:var(--purple)}.lab-hero p{max-width:680px;color:var(--muted);font-size:17px}.lab-stats{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.lab-stats span{padding:9px 12px;border:1px solid var(--line);border-radius:99px;background:var(--surface);font-size:12px}.terminal-card{padding:22px;background:#111018;color:#dcd7e8;border:1px solid #34313f;border-radius:20px;box-shadow:0 24px 60px rgba(20,15,40,.2)}.terminal-card>div:first-child{display:flex;gap:6px;align-items:center}.terminal-card i{width:9px;height:9px;border-radius:50%;background:#d76d77}.terminal-card i:nth-child(2){background:#f0a434}.terminal-card i:nth-child(3){background:#20b486}.terminal-card small{margin-left:auto;color:#777181}.terminal-card pre{min-height:105px;margin:24px 0;color:#9cf3c7;font:14px/1.9 ui-monospace,monospace}.lab-progress{height:8px;border-radius:9px;background:#27242e;overflow:hidden}.lab-progress span{display:block;height:100%;background:linear-gradient(90deg,#20b486,#9cf3c7);transition:.5s}.lab-map{padding-block:65px}.lab-zone{margin-bottom:85px}.lab-zone>header{display:grid;grid-template-columns:60px 1fr auto;gap:17px;align-items:center;max-width:850px;margin:auto}.zone-emblem{width:58px;height:58px;display:grid;place-items:center;border-radius:18px;background:color-mix(in srgb,var(--zone) 14%,var(--surface));color:var(--zone);font-size:27px}.lab-zone header p{margin:0;color:var(--zone);font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.lab-zone h2{margin:2px 0;font-size:27px}.lab-zone header span{color:var(--muted)}.lab-zone header strong{padding:10px 14px;border-radius:99px;background:var(--surface-2);color:var(--zone)}.lab-zone header strong i{font-style:normal}.path{position:relative;max-width:850px;margin:35px auto}.path:before{content:'';position:absolute;left:50%;top:15px;bottom:15px;width:4px;transform:translateX(-50%);background:var(--line);border-radius:5px}.path-stop{position:relative;min-height:155px;display:grid;grid-template-columns:1fr 100px 1fr;align-items:center}.path-stop:nth-child(odd) article{grid-column:1;text-align:right}.path-stop:nth-child(even) article{grid-column:3}.lab-node{grid-column:2;grid-row:1;width:68px;height:68px;justify-self:center;position:relative;border:4px solid var(--bg);border-radius:22px;background:var(--surface-2);color:var(--muted);box-shadow:0 0 0 2px var(--line);cursor:pointer;z-index:2;transition:.25s}.lab-node i{font-style:normal;font-weight:900;font-size:18px}.lab-node em{position:absolute;right:-8px;bottom:-8px;width:27px;height:27px;display:grid;place-items:center;border-radius:50%;background:var(--surface);border:2px solid var(--line);font-style:normal;font-size:11px}.path-stop article{grid-row:1;padding:18px 20px;background:var(--surface);border:1px solid var(--line);border-radius:17px;opacity:.48}.path-stop article small{color:var(--zone);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.path-stop article h3{margin:4px 0}.path-stop article p{margin:0 0 7px;color:var(--muted);font-size:12px}.path-stop article>span{font-size:11px;font-weight:750;color:var(--muted)}.path-stop.unlocked article{opacity:1}.path-stop.unlocked .lab-node{color:var(--zone);box-shadow:0 0 0 2px var(--zone),0 10px 28px color-mix(in srgb,var(--zone) 24%,transparent);background:color-mix(in srgb,var(--zone) 13%,var(--surface))}.path-stop.unlocked .lab-node:hover{transform:scale(1.08)}.path-stop.done .lab-node{background:var(--zone);color:#fff}.path-stop.done article>span{color:var(--zone)}
.challenge-modal{width:min(720px,calc(100% - 24px));max-height:calc(100vh - 30px);padding:0;border:1px solid var(--line);border-radius:24px;background:var(--surface);color:var(--ink);box-shadow:0 35px 100px rgba(0,0,0,.35)}.challenge-modal::backdrop{background:rgba(12,10,18,.72);backdrop-filter:blur(6px)}.challenge-close{position:absolute;right:16px;top:15px;width:37px;height:37px;border:0;border-radius:11px;background:var(--surface-2);font-size:24px;cursor:pointer}.challenge-top{display:flex;justify-content:space-between;padding:22px 70px 18px 26px;border-bottom:1px solid var(--line);color:var(--muted)}.challenge-top span{font-weight:800}.challenge-top i{font-style:normal}.challenge-body{padding:28px}.challenge-body h2{font-size:30px;margin:0 0 8px}.challenge-body>p:not(.eyebrow){color:var(--muted)}.challenge-prompt{font-size:18px;font-weight:750;margin:22px 0 14px}.challenge-body pre{padding:18px;background:#15131c;color:#f5d68a;border-radius:15px;white-space:pre-wrap;font:14px/1.7 ui-monospace,monospace}.challenge-answer{display:grid;gap:10px;margin:18px 0}.choice input{position:absolute;opacity:0}.choice span{display:flex;align-items:center;gap:12px;padding:13px;border:2px solid var(--line);border-radius:14px;cursor:pointer}.choice span b{width:32px;height:32px;display:grid;place-items:center;border-radius:9px;background:var(--surface-2)}.choice input:checked+span{border-color:var(--purple);background:color-mix(in srgb,var(--purple) 7%,var(--surface))}.fill-answer span{display:block;margin-bottom:7px;font-weight:750}.fill-answer input{width:100%;padding:14px;border:2px solid var(--line);border-radius:13px;background:var(--bg);color:var(--ink);font:700 16px ui-monospace,monospace}.order-bank{display:grid;gap:9px}.order-bank button{display:grid;grid-template-columns:30px 1fr;align-items:center;gap:10px;padding:12px;border:2px solid var(--line);border-radius:13px;background:var(--bg);text-align:left;cursor:pointer}.order-bank button i{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:var(--surface-2);font-style:normal;font-weight:900}.order-bank button.selected{border-color:var(--purple)}.order-bank button.selected i{background:var(--purple);color:#fff}.order-note{font-size:12px!important}.hint-box,.challenge-feedback{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:14px;border-radius:14px;margin:14px 0}.hint-box{background:color-mix(in srgb,#f0a434 12%,var(--surface));border:1px solid #f0a434}.hint-box p,.challenge-feedback p{margin:0}.challenge-feedback{display:block}.challenge-feedback.good{background:color-mix(in srgb,#20b486 12%,var(--surface));border:1px solid #20b486}.challenge-feedback.bad{background:color-mix(in srgb,#d75a6b 10%,var(--surface));border:1px solid #d75a6b}.challenge-feedback small{color:var(--muted)}.challenge-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}@media(max-width:760px){.lab-hero-grid{grid-template-columns:1fr}.path:before{left:35px}.path-stop{grid-template-columns:70px 1fr;min-height:145px}.lab-node{grid-column:1!important}.path-stop article,.path-stop:nth-child(odd) article,.path-stop:nth-child(even) article{grid-column:2;text-align:left}.lab-zone>header{grid-template-columns:52px 1fr}.lab-zone header strong{grid-column:1/-1;justify-self:start}.challenge-actions{flex-direction:column-reverse}.challenge-actions .button{width:100%}}@media(max-width:480px){.lab-hero{padding-top:38px}.lab-stats{display:grid}.challenge-body{padding:21px}.challenge-body h2{font-size:25px}}
</style>
