---
import AppLayout from '../layouts/AppLayout.astro';
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
---
<AppLayout title="Mi progreso"><div class="container"><header class="page-head"><p class="eyebrow">Tu perfil de aprendizaje</p><h1>Mi progreso</h1><p>Cada misión suma. Aquí puedes ver todo lo que has construido en tu aventura.</p></header>
<section class="stat-grid"><article class="card stat-card"><span>Experiencia total</span><strong>⚡ <i data-xp>0</i> XP</strong></article><article class="card stat-card"><span>Rango actual</span><strong data-rank>Novato</strong></article><article class="card stat-card"><span>Racha diaria</span><strong>🔥 <i data-streak>1</i> días</strong></article></section>
<div class="content-grid" style="margin-top:24px"><section class="card prose-card"><p class="eyebrow">Recorrido general</p><h2><span data-completed>0</span> de 15 misiones</h2><div class="progress"><span data-progress style="width:0%"></span></div><p><b data-percent>0%</b> del contenido disponible completado.</p><h2 style="margin-top:32px">Insignias</h2><div class="badge-grid"><article class="badge card" data-badge="Primer paso">🌱<h3>Primer paso</h3><p>Completa tu primera misión.</p></article><article class="badge card" data-badge="Mente lógica">🧠<h3>Mente lógica</h3><p>Completa cinco misiones.</p></article><article class="badge card" data-badge="Imparable">🔥<h3>Imparable</h3><p>Mantén una racha de 3 días.</p></article></div></section><aside class="card prose-card"><p class="eyebrow">Siguiente objetivo</p><h2 data-next-title>Primera misión</h2><p data-next-copy>Completa una microlección y gana 20 XP.</p><a class="button" data-next-link href={`${base}mision/1-1`}>Continuar →</a></aside></div></div>
<script is:inline define:vars={{base}}>
const names=['¿Qué es un algoritmo?','Hablar en pseudocódigo','Entrada · Proceso · Salida','Variables y tipos','Leer, asignar y escribir','Comparar valores','Lógica booleana','Si · Entonces · Sino','Decisiones anidadas','Según','Pensar en ciclos','Contar y acumular','Para','Mientras','Repetir · Hasta Que'],ids=['1-1','1-2','1-3','1-4','1-5','2-1','2-2','2-3','2-4','2-5','3-1','3-2','3-3','3-4','3-5'];function render(){const s=window.PQ.read(),n=s.completed.length,p=Math.round(n/15*100),i=ids.findIndex(x=>!s.completed.includes(x));document.querySelector('[data-completed]').textContent=n;document.querySelector('[data-percent]').textContent=p+'%';document.querySelector('[data-progress]').style.width=p+'%';document.querySelector('[data-rank]').textContent=s.xp>=200?'Developer':s.xp>=100?'Junior':'Novato';document.querySelector('[data-next-title]').textContent=i<0?'¡Ruta dominada!':names[i];document.querySelector('[data-next-copy]').textContent=i<0?'Repasa cualquier misión mientras llegan nuevos niveles.':'Completa esta misión y gana 20 XP.';document.querySelector('[data-next-link]').href=base+'mision/'+(i<0?'3-5':ids[i]);document.querySelectorAll('[data-badge]').forEach(el=>{const earned=s.badges.includes(el.dataset.badge)||(el.dataset.badge==='Imparable'&&s.streak>=3);el.style.opacity=earned?'1':'.38';if(earned)el.classList.add('earned')})}render();window.addEventListener('pq:update',render);
</script></AppLayout>
