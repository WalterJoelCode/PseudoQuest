---
import AppLayout from '../layouts/AppLayout.astro';const resources=[{icon:'🎓',type:'Curso universitario',title:'Algoritmos y pseudocódigo · UNAM',text:'Recurso interactivo abierto para comprender y elaborar soluciones algorítmicas.',href:'https://uapa.bunam.unam.mx/u/matematicas/pseudocodigo/'},{icon:'📘',type:'Lectura universitaria',title:'Algoritmos y sus representaciones · UGTO',text:'Conceptos, características y representación de algoritmos mediante pseudocódigo.',href:'https://blogs.ugto.mx/rea/clase-digital-4-algoritmos-y-sus-representaciones-en-pseudocodigo/'},{icon:'📄',type:'Documento PDF',title:'Fundamentos de programación',text:'Material de consulta sobre lógica, variables, decisiones, ciclos y pseudocódigo.',href:'https://biblioteca.uns.edu.pe/saladocentes/archivoz/publicacionez/Fundamentos_de_Programacion___Parte_1.pdf'},{icon:'🧪',type:'Herramienta',title:'PSeInt en SourceForge',text:'Intérprete de pseudocódigo en español para ejecutar y comprobar algoritmos.',href:'https://sourceforge.net/projects/pseint/files/'},{icon:'🌐',type:'Documentación',title:'Guía de JavaScript · MDN',text:'Siguiente paso para trasladar la lógica a variables, condiciones y ciclos reales.',href:'https://developer.mozilla.org/es/docs/Web/JavaScript/Guide'},{icon:'🗃️',type:'Documento PDF',title:'Problemas y algoritmos',text:'Lectura abierta con análisis de problemas y diseño de algoritmos.',href:'https://www.editorial.unrn.edu.ar/media/data/lecturas/problemas_algoritmos_eunrn.pdf'}];
---
<AppLayout title="Recursos para aprender"><div class="container"><header class="page-head"><p class="eyebrow">Biblioteca seleccionada</p><h1>Recursos para seguir aprendiendo</h1><p>Documentos, sitios académicos, documentación y herramientas externas para profundizar en algoritmos, pseudocódigo y programación.</p></header><section class="resource-list">{resources.map(r=><a class="card resource-row" href={r.href} target="_blank" rel="noopener noreferrer"><span>{r.icon}</span><div><small>{r.type}</small><h2>{r.title}</h2><p>{r.text}</p></div><strong>Visitar ↗</strong></a>)}</section><aside class="resource-note"><b>Nota</b><p>Estos enlaces pertenecen a instituciones y proyectos externos. PseudoQuest no está afiliado con ellos; los recomendamos por su utilidad educativa.</p></aside></div></AppLayout><style>.resource-list{display:grid;gap:12px}.resource-row{display:grid;grid-template-columns:58px 1fr auto;align-items:center;gap:18px;padding:20px;transition:.2s}.resource-row:hover{transform:translateY(-2px);border-color:var(--purple)}.resource-row>span{width:58px;height:58px;display:grid;place-items:center;border-radius:16px;background:var(--surface-2);font-size:28px}.resource-row small{color:var(--accent);text-transform:uppercase;letter-spacing:.09em;font-weight:800}.resource-row h2{font-size:18px;margin:3px 0}.resource-row p{margin:0;color:var(--muted)}.resource-row>strong{color:var(--purple)}.resource-note{margin:22px 0 70px;padding:18px;border:1px solid var(--line);border-radius:15px;background:var(--surface-2)}.resource-note p{margin:4px 0;color:var(--muted)}@media(max-width:600px){.resource-row{grid-template-columns:48px 1fr}.resource-row>span{width:48px;height:48px}.resource-row>strong{grid-column:2}}</style>
