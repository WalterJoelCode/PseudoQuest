---
import AppLayout from '../../layouts/AppLayout.astro';
import { allMissions } from '../../data/course';
export function getStaticPaths(){return allMissions.map(item=>({params:{id:item.id},props:{item}}))}
const { item }=Astro.props;
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
---
<AppLayout title={item.title}>
<div class="mission-shell" style={`--level:${item.level.color}`}>
  <header class="mission-top"><a href={base} aria-label="Salir">×</a><div><span>Nivel {item.level.id} · {item.level.name}</span><div class="progress"><i></i></div></div><strong>+{item.xp} XP</strong></header>
  <section class="lesson-step active" data-step="lesson"><p class="eyebrow">{item.eyebrow}</p><div class="lesson-icon">{item.icon}</div><h1>{item.title}</h1><p class="lesson-text">{item.lesson}</p><pre>{item.example}</pre><div class="tip"><b>Idea clave</b><span>Lee el ejemplo como una receta: cada línea tiene un propósito y un orden.</span></div><button class="button next">Entendido, practicar →</button></section>
  <section class="lesson-step" data-step="question"><p class="eyebrow">Comprueba lo aprendido</p><h1>{item.question}</h1><p class="muted">Elige una respuesta. Puedes intentarlo de nuevo si te equivocas.</p><div class="options">{item.options.map((option,i)=><button data-option={i}><kbd>{String.fromCharCode(65+i)}</kbd><span>{option}</span></button>)}</div><div class="feedback" aria-live="polite"></div><button class="button check" disabled>Comprobar respuesta</button></section>
  <section class="lesson-step" data-step="success"><div class="success-orb">🏆</div><p class="eyebrow">Misión completada</p><h1>¡La lógica está contigo!</h1><p class="lesson-text">{item.feedback}</p><div class="xp-win"><span>⚡</span><div><b>+{item.xp} XP</b><small>Experiencia obtenida</small></div></div><a class="button" href={base} id="finish">Volver a la ruta →</a></section>
</div>
<script is:inline define:vars={{answer:item.answer,id:item.id,xp:item.xp}}>
const steps=[...document.querySelectorAll('.lesson-step')],show=n=>{steps.forEach(x=>x.classList.remove('active'));steps[n].classList.add('active');document.querySelector('.mission-top i').style.width=((n+1)/3*100)+'%'};document.querySelector('.next').addEventListener('click',()=>show(1));let chosen=-1;const options=[...document.querySelectorAll('[data-option]')],check=document.querySelector('.check'),feedback=document.querySelector('.feedback');options.forEach(o=>o.addEventListener('click',()=>{options.forEach(x=>x.classList.remove('selected'));o.classList.add('selected');chosen=Number(o.dataset.option);check.disabled=false}));check.addEventListener('click',()=>{if(chosen===answer){options[chosen].classList.add('correct');feedback.className='feedback good';feedback.textContent='✓ '+document.querySelector('[data-step=success] .lesson-text').textContent;window.PQ.tone('win');setTimeout(()=>{const s=window.PQ.read();if(!s.completed.includes(id)){s.completed.push(id);s.xp+=xp;if(s.completed.length===1&&!s.badges.includes('Primer paso'))s.badges.push('Primer paso');if(s.completed.length===5&&!s.badges.includes('Mente lógica'))s.badges.push('Mente lógica');window.PQ.save(s)}show(2)},900)}else{options[chosen].classList.add('wrong');feedback.className='feedback bad';feedback.textContent='Casi. Revisa la microlección y prueba otra opción.';window.PQ.tone('bad')}});
</script>
</AppLayout>
<style>
.mission-shell{min-height:calc(100vh - 74px);padding:25px 20px 70px}.mission-top{width:min(780px,100%);margin:0 auto 35px;display:grid;grid-template-columns:35px 1fr auto;align-items:center;gap:20px}.mission-top>a{font-size:30px;color:var(--muted)}.mission-top>div>span{font-size:12px;color:var(--muted);font-weight:700}.mission-top .progress{margin-top:8px}.mission-top i{display:block;width:33%;height:100%;background:var(--level);transition:.4s}.mission-top strong{color:var(--level)}.lesson-step{display:none;width:min(720px,100%);margin:auto;text-align:center;animation:rise .35s ease}.lesson-step.active{display:block}.lesson-icon,.success-orb{width:90px;height:90px;margin:10px auto 22px;border-radius:28px;display:grid;place-items:center;background:color-mix(in srgb,var(--level) 14%,var(--surface));font-size:40px}.lesson-step h1{font-size:clamp(28px,5vw,42px);line-height:1.12;margin:0 auto 18px}.lesson-text,.muted{color:var(--muted);font-size:17px;max-width:620px;margin:0 auto 22px}.lesson-step pre{text-align:left;white-space:pre-wrap;background:#19171f;color:#f5d68a;border-radius:16px;padding:22px;margin:25px 0;font:14px/1.7 ui-monospace,monospace}.tip{display:flex;text-align:left;gap:16px;padding:16px;border:1px solid var(--line);border-radius:14px;margin-bottom:26px}.tip b{color:var(--level);white-space:nowrap}.tip span{color:var(--muted)}.options{display:grid;gap:11px;margin:28px 0}.options button{display:flex;align-items:center;gap:14px;padding:14px;border:2px solid var(--line);border-radius:14px;background:var(--surface);cursor:pointer;text-align:left}.options button:hover,.options button.selected{border-color:var(--level);background:color-mix(in srgb,var(--level) 6%,var(--surface))}.options button.correct{border-color:#20b486;background:color-mix(in srgb,#20b486 12%,var(--surface))}.options button.wrong{border-color:#d75a6b}.options kbd{width:30px;height:30px;display:grid;place-items:center;background:var(--surface-2);border-radius:8px;font-weight:800}.check:disabled{opacity:.45;cursor:not-allowed}.feedback{min-height:26px;margin-bottom:14px;font-weight:700}.feedback.good{color:#20b486}.feedback.bad{color:#d75a6b}.success-orb{font-size:46px;animation:pop .6s}.xp-win{display:flex;justify-content:center;align-items:center;gap:12px;margin:30px auto}.xp-win>span{font-size:32px}.xp-win b,.xp-win small{display:block;text-align:left}.xp-win b{font-size:24px;color:var(--level)}.xp-win small{color:var(--muted)}@keyframes rise{from{opacity:0;transform:translateY(12px)}}@keyframes pop{50%{transform:scale(1.2) rotate(8deg)}}
</style>
