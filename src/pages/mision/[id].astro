---
import AppLayout from '../../layouts/AppLayout.astro';
import {allMissions} from '../../data/course';
export function getStaticPaths(){return allMissions.map(item=>({params:{id:item.id},props:{item}}))}
const{item}=Astro.props;const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
---
<AppLayout title={item.title}><div class="mission-shell" style={`--level:${item.level.color}`}>
<header class="mission-hud"><a href={`${base}misiones`} aria-label="Salir del juego">×</a><div><small>Nivel {item.level.id} · Juego {item.id.split('-')[1]}</small><div class="progress"><i></i></div></div><b data-label>Preparación</b></header>
<section class="step active lesson" data-page="lesson"><p class="eyebrow">{item.eyebrow}</p><div class="orb">{item.icon}</div><h1>{item.title}</h1><p class="lead">Comprende la regla, aprende a reconocerla y revisa cómo se representa en PSeInt.</p><div class="lesson-heading"><span>01</span><div><b>Fundamento del juego</b><small>Cuatro ideas esenciales antes de practicar</small></div></div><div class="copy">{item.lesson.map((p,i)=><article><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></article>)}</div><div class="lesson-heading"><span>02</span><div><b>Lectura del pseudocódigo</b><small>Relaciona la teoría con una estructura concreta</small></div></div><div class="example"><div><span>⌨</span><b>Ejemplo en PSeInt</b></div><pre>{item.example}</pre><p>Haz una prueba de escritorio: anota los datos iniciales, ejecuta cada instrucción en orden y predice la salida.</p></div><div class="ready" aria-label="Información de la actividad"><span>8 retos</span><span>Hasta {item.xp} XP</span><span>Progreso guardado</span></div><button class="button start" data-start>Comenzar los retos →</button></section>
<section class="step quiz" data-page="quiz"><div class="quest-strip"><span data-kind></span><b>Pregunta <i data-number></i> de 8</b><span>⭐ <i data-live-score>0</i></span></div><h1 data-prompt></h1><p class="instruction">Selecciona una opción. Recibirás la explicación inmediatamente.</p><div class="options" data-options></div><div class="feedback" data-feedback aria-live="polite"></div><button class="button next-question" data-next hidden></button></section>
<section class="step result" data-page="result"><div class="confetti" aria-hidden="true">✦ ◆ ★ ✦ ◆</div><div class="orb trophy">🏆</div><p class="eyebrow">Juego completado y guardado</p><h1><span data-score></span> de 8 correctas</h1><p data-copy></p><div class="reward"><span>⚡</span><div><b><span data-earned></span> XP nuevos</b><small>Mejor resultado conservado</small></div></div><div class="actions"><button class="button secondary" data-retry>↻ Mejorar puntuación</button><a class="button" href={`${base}misiones`}>Ver misiones →</a></div></section></div>
<script is:inline define:vars={{questions:item.questions,id:item.id,maxXp:item.xp}}>
let n=0,score=0,answered=false;const pages=[...document.querySelectorAll('.step')],bar=document.querySelector('.mission-hud i'),next=document.querySelector('[data-next]');
function page(name){pages.forEach(el=>el.classList.toggle('active',el.dataset.page===name));document.querySelector('[data-label]').textContent=name==='lesson'?'Preparación':name==='quiz'?'En misión':'Completado';bar.style.width=name==='lesson'?'8%':name==='result'?'100%':`${(n+1)/8*100}%`;scrollTo({top:0,behavior:'smooth'})}
function render(){const x=questions[n],box=document.querySelector('[data-options]');answered=false;document.querySelector('[data-number]').textContent=n+1;document.querySelector('[data-kind]').textContent=x.kind;document.querySelector('[data-prompt]').textContent=x.prompt;document.querySelector('[data-live-score]').textContent=score;document.querySelector('[data-feedback]').className='feedback';document.querySelector('[data-feedback]').innerHTML='';next.hidden=true;box.innerHTML='';x.options.forEach((label,i)=>{const button=document.createElement('button');button.innerHTML=`<kbd>${String.fromCharCode(65+i)}</kbd><span>${label}</span><em aria-hidden="true"></em>`;button.addEventListener('click',()=>answer(i));box.appendChild(button)});page('quiz')}
function answer(selected){if(answered)return;answered=true;const x=questions[n],buttons=[...document.querySelector('[data-options]').children],correct=selected===x.answer,feedback=document.querySelector('[data-feedback]');buttons.forEach((button,i)=>{button.disabled=true;if(i===x.answer){button.classList.add('correct');button.querySelector('em').textContent='✓'}if(i===selected&&i!==x.answer){button.classList.add('wrong');button.querySelector('em').textContent='×'}});if(correct){score++;feedback.className='feedback good';feedback.innerHTML=`<span>✨</span><div><b>¡Correcto! +1 estrella</b><p>${x.explanation}</p></div>`;window.PQ.tone('ok')}else{feedback.className='feedback bad';feedback.innerHTML=`<span>🧠</span><div><b>Aún estás aprendiendo</b><p>La respuesta es <strong>${x.options[x.answer]}</strong>. ${x.explanation}</p></div>`;window.PQ.tone('bad')}document.querySelector('[data-live-score]').textContent=score;if(n===7){next.hidden=true;feedback.insertAdjacentHTML('beforeend','<small class="saving-note">Guardando misión completada…</small>');setTimeout(finish,1100)}else{next.hidden=false;next.textContent='Siguiente pregunta →';next.focus()}}
next.addEventListener('click',()=>{if(!answered)return;if(n<7){n++;render()}else finish()});
function finish(){const earned=Math.round(maxXp*score/8),state=window.PQ.read();state.bestScores=state.bestScores||{};state.missionXp=state.missionXp||{};const previous=state.missionXp[id]||0,delta=Math.max(0,earned-previous);state.missionXp[id]=Math.max(previous,earned);state.bestScores[id]=Math.max(state.bestScores[id]||0,score);state.completed=[...new Set([...(state.completed||[]),id])];state.xp=Math.max(0,Number(state.xp)||0)+delta;window.PQ.save(state);document.querySelector('[data-score]').textContent=score;document.querySelector('[data-earned]').textContent=delta;document.querySelector('[data-copy]').textContent=delta?`¡Misión guardada! Nuevo récord y ${delta} XP adicionales.`:'¡Misión guardada! Conservamos tu mejor puntuación y tu XP.';window.PQ.tone('win');page('result')}
document.querySelector('[data-start]').addEventListener('click',render);document.querySelector('[data-retry]').addEventListener('click',()=>{n=0;score=0;render()});
</script></AppLayout>
<style>
.mission-shell{min-height:calc(100vh - 74px);padding:25px 20px 80px;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--level) 8%,transparent),transparent 380px)}.mission-hud{width:min(850px,100%);margin:0 auto 34px;display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:20px;position:sticky;top:88px;z-index:5;padding:12px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-radius:14px}.mission-hud>a{font-size:30px;color:var(--muted);text-align:center}.mission-hud small{color:var(--muted)}.mission-hud i{display:block;height:100%;width:8%;background:linear-gradient(90deg,var(--level),var(--accent));transition:width .45s cubic-bezier(.2,.8,.2,1)}.step{display:none;width:min(800px,100%);margin:auto;text-align:center}.step.active{display:block;animation:step-in .35s ease}.orb{width:88px;height:88px;margin:8px auto 20px;border-radius:27px;display:grid;place-items:center;background:color-mix(in srgb,var(--level) 14%,var(--surface));font-size:40px;box-shadow:0 12px 30px color-mix(in srgb,var(--level) 18%,transparent);animation:float 3s ease-in-out infinite}.step h1{font-size:clamp(29px,5vw,44px);line-height:1.12}.lead,.instruction{color:var(--muted)}.copy{text-align:left;color:var(--muted);font-size:17px;line-height:1.75;background:var(--surface);padding:24px;border:1px solid var(--line);border-radius:18px}.copy p:first-child{color:var(--ink);font-weight:600}.knowledge-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0;text-align:left}.knowledge-grid article{padding:20px;background:var(--surface);border:1px solid var(--line);border-radius:18px}.knowledge-grid article>span{font-size:25px}.knowledge-grid h2{font-size:17px;margin:8px 0}.knowledge-grid li{margin:7px 0;color:var(--muted)}.example{text-align:left;background:#17151d;color:#eee;border-radius:18px;overflow:hidden}.example>div{padding:14px 20px;border-bottom:1px solid #34313c;display:flex;gap:9px}.example pre{white-space:pre-wrap;color:#f5d68a;padding:20px;margin:0;font:14px/1.75 ui-monospace,monospace}.example p{padding:0 20px 18px;margin:0;color:#aaa6b2}.key{display:flex;gap:14px;padding:18px;border:1px solid color-mix(in srgb,var(--level) 40%,var(--line));border-radius:16px;margin:18px 0;text-align:left;background:color-mix(in srgb,var(--level) 7%,var(--surface))}.key>span{font-size:24px}.key p{margin:4px 0;color:var(--muted)}.ready{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin:20px}.ready span{padding:7px 11px;border-radius:99px;background:var(--surface-2);font-size:12px;font-weight:700}.start{font-size:16px}.quest-strip{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:15px}.quest-strip>span:first-child{justify-self:start;color:var(--level);font-weight:800}.quest-strip>span:last-child{justify-self:end}.quest-strip i{font-style:normal}.options{display:grid;gap:12px;margin:28px 0 18px}.options button{position:relative;display:grid;grid-template-columns:38px 1fr 30px;align-items:center;gap:14px;padding:16px;border:2px solid var(--line);border-radius:16px;background:var(--surface);text-align:left;cursor:pointer;transition:transform .18s,border-color .18s,background .18s}.options button:not(:disabled):hover{transform:translateY(-2px);border-color:var(--level);box-shadow:var(--shadow)}.options button:disabled{color:var(--ink);cursor:default}.options kbd{width:36px;height:36px;display:grid;place-items:center;background:var(--surface-2);border-radius:10px;font-weight:800}.options em{font-size:24px;font-style:normal;text-align:center}.options button.correct{border-color:#18a878;background:color-mix(in srgb,#18a878 10%,var(--surface));animation:correct-pop .35s}.options button.correct em{color:#18a878}.options button.wrong{border-color:#d75a6b;background:color-mix(in srgb,#d75a6b 9%,var(--surface));animation:shake .32s}.options button.wrong em{color:#d75a6b}.feedback{min-height:0;display:none;text-align:left}.feedback.good,.feedback.bad{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:17px;border-radius:15px;margin:16px 0}.feedback.good{color:#117b59;background:color-mix(in srgb,#18a878 12%,var(--surface));border:1px solid #18a878}.feedback.bad{color:#b23f51;background:color-mix(in srgb,#d75a6b 10%,var(--surface));border:1px solid #d75a6b}.feedback>span{font-size:25px}.feedback p{margin:4px 0;color:var(--ink)}.next-question{animation:step-in .25s}.confetti{color:var(--level);font-size:28px;letter-spacing:18px;animation:confetti 1s ease}.trophy{animation:trophy .8s ease}.reward{display:flex;justify-content:center;align-items:center;gap:12px;margin:25px}.reward>span{font-size:34px}.reward b,.reward small{display:block;text-align:left}.reward small{color:var(--muted)}.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}@keyframes step-in{from{opacity:0;transform:translateY(12px)}}@keyframes float{50%{transform:translateY(-6px)}}@keyframes correct-pop{50%{transform:scale(1.015)}}@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}@keyframes trophy{50%{transform:scale(1.2) rotate(8deg)}}@keyframes confetti{from{opacity:0;transform:translateY(-20px) scale(.7)}}@media(max-width:650px){.knowledge-grid{grid-template-columns:1fr}.mission-hud{top:78px}.quest-strip{grid-template-columns:1fr 1fr}.quest-strip>b{grid-row:2;grid-column:1/-1}.options button{padding:13px}.copy{padding:18px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
<style>
.lesson-heading{display:flex;align-items:center;gap:12px;margin:30px 0 12px;text-align:left}.lesson-heading>span{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border-radius:11px;background:color-mix(in srgb,var(--level) 14%,var(--surface));color:var(--level);font-weight:900;font-size:12px}.lesson-heading b,.lesson-heading small{display:block}.lesson-heading b{font-size:18px}.lesson-heading small{margin-top:2px;color:var(--muted)}
.lesson .copy{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0;border:0;background:transparent;font-size:inherit;line-height:inherit}.lesson .copy article{display:grid;grid-template-columns:32px 1fr;gap:10px;align-content:start;padding:20px;background:var(--surface);border:1px solid var(--line);border-radius:16px}.lesson .copy article>span{width:29px;height:29px;display:grid;place-items:center;border-radius:9px;background:var(--surface-2);color:var(--level);font-size:11px;font-weight:900}.lesson .copy p{margin:0;color:var(--muted);font-size:15px;line-height:1.65}.lesson .copy article:first-child{grid-column:1/-1;border-color:color-mix(in srgb,var(--level) 35%,var(--line));background:color-mix(in srgb,var(--level) 5%,var(--surface))}.lesson .copy article:first-child p{color:var(--ink);font-weight:600}.lesson .example{box-shadow:0 10px 30px rgba(20,16,28,.12)}.lesson .start{min-width:220px}
@media(max-width:650px){.lesson-heading{margin-top:24px}.lesson .copy{grid-template-columns:1fr}.lesson .copy article:first-child{grid-column:auto}.lesson .copy article{padding:16px}.lesson .copy p{font-size:14px}.lesson .start{width:100%}}
</style>
<style>.lesson .copy article:first-child{grid-column:auto!important}</style>
<style is:global>
.mission-shell .options button{position:relative;width:100%;display:grid;grid-template-columns:42px minmax(0,1fr) 34px;align-items:center;gap:14px;padding:16px 18px;border:2px solid var(--line);border-radius:16px;background:var(--surface);color:var(--ink);font:650 15px/1.45 Inter,system-ui,sans-serif;text-align:left;cursor:pointer;box-shadow:0 5px 16px rgba(48,35,78,.05);transition:transform .18s,border-color .18s,background .18s,box-shadow .18s}
.mission-shell .options button:not(:disabled):hover{transform:translateY(-2px);border-color:var(--level);background:color-mix(in srgb,var(--level) 5%,var(--surface));box-shadow:0 12px 26px color-mix(in srgb,var(--level) 16%,transparent)}
.mission-shell .options button:not(:disabled):focus-visible{outline:3px solid color-mix(in srgb,var(--level) 34%,transparent);outline-offset:3px;border-color:var(--level)}
.mission-shell .options button:disabled{opacity:1;color:var(--ink);cursor:default}
.mission-shell .options button kbd{width:38px;height:38px;display:grid;place-items:center;background:var(--surface-2);border:1px solid var(--line);border-radius:11px;color:var(--muted);font:800 13px/1 Inter,system-ui,sans-serif;box-shadow:0 2px 0 var(--line)}
.mission-shell .options button>span{display:block;min-width:0}.mission-shell .options button em{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;font-size:20px;font-style:normal}
.mission-shell .options button.correct{border-color:#18a878;background:color-mix(in srgb,#18a878 11%,var(--surface));box-shadow:0 8px 22px color-mix(in srgb,#18a878 18%,transparent)}
.mission-shell .options button.correct kbd,.mission-shell .options button.correct em{background:#18a878;border-color:#18a878;color:#fff;box-shadow:none}
.mission-shell .options button.wrong{border-color:#d75a6b;background:color-mix(in srgb,#d75a6b 10%,var(--surface));box-shadow:0 8px 22px color-mix(in srgb,#d75a6b 16%,transparent)}
.mission-shell .options button.wrong kbd,.mission-shell .options button.wrong em{background:#d75a6b;border-color:#d75a6b;color:#fff;box-shadow:none}
.mission-shell .feedback>span{font-size:25px}.mission-shell .feedback b{font-size:16px}.mission-shell .feedback p{margin:4px 0;color:var(--ink);font-weight:500}.mission-shell .feedback strong{color:inherit}.mission-shell .saving-note{display:block;margin-top:9px;color:var(--muted);font-weight:700}
@media(max-width:650px){.mission-shell .options button{grid-template-columns:38px minmax(0,1fr) 30px;padding:13px 12px;gap:10px}}
</style>
