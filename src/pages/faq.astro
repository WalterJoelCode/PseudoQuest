---
import AppLayout from '../layouts/AppLayout.astro';
const faqs=[['¿Necesito saber programar?','No. El recorrido comienza desde el concepto de algoritmo y avanza paso a paso.'],['¿Mi progreso se guarda?','Sí, se guarda en este navegador mediante localStorage. No necesitas una cuenta.'],['¿Qué pasa si me equivoco?','Recibes feedback inmediato y puedes volver a intentarlo sin perder XP.'],['¿PseudoQuest reemplaza a PSeInt?','No. PseudoQuest prepara tu pensamiento lógico; PSeInt será la herramienta externa para practicar algoritmos completos.'],['¿Cuándo estarán Senior y Master?','Aparecen como próximos niveles y alojarán vectores, matrices, funciones y resolución avanzada.']];
---
<AppLayout title="Preguntas frecuentes"><div class="container"><header class="page-head"><p class="eyebrow">Centro de ayuda</p><h1>Preguntas frecuentes</h1><p>Respuestas rápidas para seguir tu aventura sin perder el ritmo.</p></header><section style="max-width:820px;padding-bottom:70px">{faqs.map(([q,a],i)=><details class="card" style="padding:20px;margin-bottom:12px" open={i===0}><summary style="font-weight:750;cursor:pointer">{q}</summary><p style="color:var(--muted);margin-bottom:0">{a}</p></details>)}</section></div></AppLayout>
