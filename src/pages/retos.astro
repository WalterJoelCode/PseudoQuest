---
import AppLayout from '../layouts/AppLayout.astro';
const levels=[
{id:1,name:'Fundamentos',color:'#7c5cff',intro:'Construye programas completos con entradas, operaciones, tipos y salidas.',challenges:[
{title:'Conversor de temperatura',goal:'Lee grados Celsius y calcula Fahrenheit con F = C × 9 / 5 + 32.',requirements:['Define variables de tipo Real','Muestra ambas temperaturas','Prueba con 0, 25 y 100']},
{title:'Cambio de una compra',goal:'Lee el costo y el monto pagado; calcula el cambio que debe recibir el cliente.',requirements:['Usa asignación con <-','Muestra los datos de entrada','Prueba pagos exactos y mayores al costo']},
{title:'Promedio ponderado',goal:'Calcula la nota final con tres calificaciones que pesan 30 %, 30 % y 40 %.',requirements:['Usa variables Real','Aplica correctamente los porcentajes','Muestra el resultado con una etiqueta clara']}]},
{id:2,name:'Decisiones',color:'#20b486',intro:'Implementa reglas mediante comparaciones, operadores lógicos y rutas alternativas.',challenges:[
{title:'Tarifa de envío',goal:'El envío es gratis si la compra supera 1000 o el cliente es miembro; en otro caso cuesta 80.',requirements:['Usa el operador O','Prueba las cuatro combinaciones','Muestra costo de envío y total']},
{title:'Clasificador de calificaciones',goal:'Clasifica una nota: Excelente 90–100, Bueno 80–89, Suficiente 60–79 o Reprobado.',requirements:['Valida primero el rango 0–100','Usa decisiones anidadas ordenadas','Prueba exactamente 60, 80 y 90']},
{title:'Menú de calculadora',goal:'Con Según, permite elegir suma, resta, multiplicación o división de dos números.',requirements:['Incluye De Otro Modo','Evita dividir entre cero','Muestra la operación y el resultado']}]},
{id:3,name:'Repetición',color:'#f0a434',intro:'Resuelve procesos repetitivos controlando vueltas, contadores y acumuladores.',challenges:[
{title:'Estadísticas de notas',goal:'Lee 10 notas y muestra promedio, cantidad de aprobados y cantidad de reprobados.',requirements:['Usa acumulador y contadores','Clasifica con nota >= 60','Calcula el promedio al terminar']},
{title:'Clave con intentos',goal:'Solicita una clave hasta acertar; bloquea después de tres intentos incorrectos.',requirements:['Usa Mientras o Repetir','Cuenta cada intento','Distingue acceso y bloqueo']},
{title:'Caja hasta centinela',goal:'Lee importes y acumúlalos hasta que se ingrese 0; luego muestra total y cantidad de ventas.',requirements:['El 0 no cuenta como venta','Admite una cantidad desconocida de datos','Evita dividir entre cero si calculas promedio']}]}
];
---
<AppLayout title="Retos de práctica"><div class="container"><header class="page-head"><p class="eyebrow">Práctica externa en PSeInt</p><h1>Retos para resolver en tu computadora</h1><p>Nueve ejercicios para convertir la teoría en programas completos. Descarga PSeInt, crea un algoritmo nuevo y prueba cada solución con distintos datos.</p></header><aside class="notice"><span>ℹ</span><div><b>Actividad sin corrección automática</b><p>Estos retos no otorgan XP y PseudoQuest no puede revisar el archivo. Tu docente puede solicitar el pseudocódigo o el archivo <code>.psc</code> como evidencia si lo considera necesario.</p></div></aside><div class="challenge-levels">{levels.map(level=><section class="challenge-level" style={`--level:${level.color}`}><header><span>Nivel {level.id}</span><h2>{level.name}</h2><p>{level.intro}</p></header><div class="challenge-grid">{level.challenges.map((challenge,i)=><article class="card challenge-card"><div class="challenge-top"><span>{String(i+1).padStart(2,'0')}</span><small>Sin XP · práctica local</small></div><h3>{challenge.title}</h3><p>{challenge.goal}</p><h4>Requisitos mínimos</h4><ul>{challenge.requirements.map(item=><li>{item}</li>)}</ul></article>)}</div></section>)}</div></div></AppLayout>
<style>.page-head{max-width:780px}.notice{display:grid;grid-template-columns:40px 1fr;gap:12px;margin:24px 0 34px;padding:18px;border:1px solid color-mix(in srgb,var(--accent) 40%,var(--line));border-radius:16px;background:color-mix(in srgb,var(--accent) 7%,var(--surface))}.notice>span{width:36px;height:36px;display:grid;place-items:center;border-radius:11px;background:var(--surface);font-weight:900}.notice p{margin:4px 0 0;color:var(--muted)}.challenge-level{margin:42px 0}.challenge-level>header{max-width:680px;margin-bottom:16px}.challenge-level>header>span{color:var(--level);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.challenge-level h2{margin:5px 0;font-size:28px}.challenge-level>header p{margin:0;color:var(--muted)}.challenge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.challenge-card{padding:22px;border-top:3px solid var(--level)}.challenge-top{display:flex;align-items:center;justify-content:space-between}.challenge-top>span{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:color-mix(in srgb,var(--level) 12%,var(--surface-2));color:var(--level);font-size:12px;font-weight:900}.challenge-top small{color:var(--muted)}.challenge-card h3{margin:16px 0 7px;font-size:20px}.challenge-card>p{min-height:48px;margin:0;color:var(--muted)}.challenge-card h4{margin:18px 0 7px;font-size:13px;text-transform:uppercase;letter-spacing:.07em}.challenge-card ul{margin:0;padding-left:20px;color:var(--muted)}.challenge-card li{margin:6px 0}@media(max-width:950px){.challenge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.challenge-grid{grid-template-columns:1fr}.challenge-card>p{min-height:0}.notice{grid-template-columns:1fr}.challenge-level{margin:34px 0}}</style>
