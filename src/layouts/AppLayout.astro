---
import '../styles/app.css';
import '../styles/progress-widget.css';
import '../styles/logo.css';
import '../styles/experience.css';
import '../styles/footer.css';
import '../styles/audio.css';
import '../styles/kepler.css';
import '../styles/visuals.css';
import '../styles/release-modal.css';
import '../styles/lab-future.css';
import '../styles/ux-fixes.css';
import '../styles/responsive-navigation.css';
import '../styles/ship-interactions.css';
interface Props { title?: string; description?: string; }
const { title='KeplerCode', description='Reconstruye el conocimiento perdido: aprende lógica, algoritmos y pseudocódigo.' }=Astro.props;
const path=Astro.url.pathname;
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/`;
const url=(value:string)=>`${base}${value.replace(/^\//,'')}`;
const pageTitle=title==='KeplerCode' ? 'KeplerCode · PseudoQuest' : `${title} · KeplerCode`;
const canonical=new URL(path,Astro.site ?? Astro.url.origin).href;
const socialImage=new URL(url('/keplercode-social.png'),Astro.site ?? Astro.url.origin).href;
---
<!doctype html><html lang="es"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#0b101c"><link rel="canonical" href={canonical}><link rel="icon" type="image/svg+xml" href={url('/favicon.svg')}><meta property="og:type" content="website"><meta property="og:site_name" content="PseudoQuest · KeplerCode"><meta property="og:locale" content="es_NI"><meta property="og:title" content={pageTitle}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:image" content={socialImage}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="KeplerCode, una aventura de PseudoQuest para reconstruir algoritmos en Kepler-22b"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={description}><meta name="twitter:image" content={socialImage}><title>{pageTitle}</title>
<script is:inline>document.documentElement.dataset.theme=localStorage.getItem('pq-theme')||'dark';</script>
</head><body>
<div class="space-atmosphere" aria-hidden="true"><i class="kepler-sun"></i><i class="kepler-planet"><b></b></i><i class="kepler-moon moon-one"></i><i class="kepler-moon moon-two"></i><i class="galaxy galaxy-one"></i><i class="galaxy galaxy-two"></i><i class="nebula nebula-a"></i><i class="nebula nebula-b"></i><i class="orbit orbit-a"></i><i class="orbit orbit-b"></i><svg class="kepler-vessel vessel-distant vessel-one" viewBox="0 0 180 72"><path class="vessel-trail" d="M4 38h72"/><path class="vessel-hull" d="M70 36 119 13l45 23-45 23z"/><path class="vessel-wing" d="m105 27 7-23 15 24M105 45l7 23 15-24"/><circle cx="143" cy="36" r="5"/></svg><svg class="kepler-vessel vessel-distant vessel-two" viewBox="0 0 180 72"><path class="vessel-trail" d="M4 38h72"/><path class="vessel-hull" d="M70 36 119 13l45 23-45 23z"/><path class="vessel-wing" d="m105 27 7-23 15 24M105 45l7 23 15-24"/><circle cx="143" cy="36" r="5"/></svg><svg class="kepler-vessel vessel-distant vessel-three" viewBox="0 0 180 72"><path class="vessel-trail" d="M4 38h72"/><path class="vessel-hull" d="M70 36 119 13l45 23-45 23z"/><path class="vessel-wing" d="m105 27 7-23 15 24M105 45l7 23 15-24"/><circle cx="143" cy="36" r="5"/></svg></div>
<header class="topbar">
  <a class="brand" href={url('/')} aria-label="PseudoQuest KeplerCode, centro de operaciones"><span class="kepler-mark" aria-hidden="true"><b>K</b><i></i></span><span class="brand-lockup"><small>PSEUDOQUEST</small><strong>KEPLER<i>CODE</i></strong></span></a>
  <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú principal" aria-controls="main-nav" aria-expanded="false"><span></span><span></span><span></span></button>
  <nav class="main-nav" id="main-nav" aria-label="Navegación principal"><a class:list={{active:path===base}} href={url('/')}>Centro</a><a class:list={{active:path.includes('/mision')}} href={url('/misiones')}>Misiones</a><a class:list={{active:path.includes('/terminal')}} href={url('/terminal')}>Terminal</a><a class:list={{active:path.includes('/retos')}} href={url('/retos')}>Transmisiones</a><a class:list={{active:path.includes('/progreso')}} href={url('/progreso')}>Reconstrucción</a><a class:list={{active:path.includes('/material')}} href={url('/material-estudio')}>Archivo</a></nav>
  <div class="top-actions"><div class="mini-stat" title="Racha actual"><span>🔥</span><b data-streak>1</b></div><div class="mini-stat" title="Experiencia total"><span>⚡</span><b data-xp>0</b></div><button class="icon-button" id="sound-toggle" aria-label="Abrir controles de audio" aria-haspopup="dialog">🔊</button><button class="icon-button" id="theme-toggle" aria-label="Cambiar tema">◐</button></div>
</header>
<main><slot /></main>
{path.includes('/terminal') && <section class="future-trail" aria-label="La ruta de la terminal continuará"><div class="trail-core"><i></i><i></i><i></i><span></span></div><p>SEÑAL INTERESTELAR // LA RUTA CONTINÚA</p></section>}
{path===base && <section class="intro-replay container"><div class="replay-signal" aria-hidden="true"><i></i><span>◉</span></div><div><p class="eyebrow">TRANSMISIÓN HISTÓRICA // DISPONIBLE</p><h2>Revive la llegada a Kepler</h2><p>Reproduce el protocolo de activación personalizado para tu identidad.</p></div><button class="button secondary" data-replay-intro>REPRODUCIR INTRO <span>▶</span></button></section>}
<footer class="site-footer"><div class="footer-main"><section class="footer-brand"><a class="brand small" href={url('/')}><span class="kepler-mark"><b>K</b><i></i></span><span class="brand-lockup"><small>PSEUDOQUEST</small><strong>KEPLER<i>CODE</i></strong></span></a><p>Reconstruye el código. Recupera el conocimiento. Reinicia el futuro.</p><div class="system-health"><span><i></i>SISTEMA ONLINE</span><span>KEPLER // 2187</span></div></section><nav class="footer-group" aria-label="Navegación de Kepler"><strong>Navegación</strong><a href={url('/misiones')}>Mapa de misiones</a><a href={url('/terminal')}>Terminal Kepler</a><a href={url('/progreso')}>Reconstrucción</a></nav><nav class="footer-group" aria-label="Archivo"><strong>Archivo</strong><a href={url('/material-estudio')}>Conocimiento</a><a href={url('/faq')}>Protocolos de ayuda</a><a href={url('/acerca')}>Sobre KeplerCode</a></nav></div><div class="footer-bottom"><p>KNOWLEDGE RECOVERY PROTOCOL <span>// ACTIVE</span></p><div class="footer-meta"><small>Desarrollado por <a href="https://github.com/walterjoelcode" target="_blank" rel="noopener noreferrer">@walterjoelcode</a> · Datos locales</small><button class="version-link" id="version-open" aria-haspopup="dialog">SISTEMA 1.6.1</button></div></div></footer>
<dialog class="version-modal release-console" id="version-modal" aria-labelledby="version-title"><div class="release-scan" aria-hidden="true"></div><header class="release-header"><div class="release-symbol"><b>1.6.1</b><i></i></div><div><p class="eyebrow">KEPLER SYSTEM // CHANGELOG</p><h2 id="version-title">Actualización 1.6.1</h2><span><i></i> INSTALACIÓN VERIFICADA</span></div><button class="modal-close" id="version-close" aria-label="Cerrar actualización">×</button></header><p class="modal-intro">La experiencia PseudoQuest evoluciona a KeplerCode: una reconstrucción narrativa, visual y sonora del entrenamiento lógico.</p><div class="release-metrics"><span><b>30</b> anomalías</span><span><b>15</b> misiones</span><span><b>7</b> capítulos</span></div><ul class="release-list"><li><span>01</span><div><b>Protocolo narrativo expandido</b><p>Una introducción completa desde la Tierra hasta Kepler-22b, con hibernación, sonidos y asignación personalizada.</p></div></li><li><span>02</span><div><b>Interfaz orbital adaptativa</b><p>Planeta, sol, lunas, galaxias y tráfico interestelar reaccionan a los modos claro y oscuro.</p></div></li><li><span>03</span><div><b>Terminal Kepler restaurada</b><p>Los 30 retos conservan su lógica y ahora forman una ruta tecnológica dentro de la colonia.</p></div></li><li><span>04</span><div><b>Identidad del Reconstructor</b><p>Nuevas distinciones, centro de operaciones, progreso local y bienvenida personalizada.</p></div></li></ul><form method="dialog"><small>PSEUDOQUEST BASE // KEPLERCODE EXPERIENCE</small><button class="button">CONTINUAR OPERACIÓN →</button></form></dialog>
<button class="progress-fab" id="progress-open" aria-haspopup="dialog"><span>◇</span><b>Reconstrucción</b><small><i data-xp>0</i> XP</small></button>
<dialog class="progress-modal" id="progress-modal" aria-labelledby="progress-modal-title"><div class="modal-head"><div><p class="eyebrow">Resumen de aventura</p><h2 id="progress-modal-title">Hola, <span data-modal-alias>Aventurero</span></h2></div><button class="modal-close" id="progress-close" aria-label="Cerrar">×</button></div><div class="progress-summary"><article><span>⚡</span><b data-modal-xp>0</b><small>XP acumulados</small></article><article><span>✓</span><b data-modal-completed>0</b><small>Misiones hechas</small></article><article><span>🏆</span><b data-modal-badges>0</b><small>Insignias</small></article></div><div class="progress"><span data-modal-bar></span></div><p class="modal-next" data-modal-next></p><a class="button progress-full-link" href={url('/progreso')}>Ver progreso completo →</a></dialog>
<dialog class="audio-modal" id="audio-modal" aria-labelledby="audio-title"><div class="modal-head"><div><p class="eyebrow">Sonido de la aventura</p><h2 id="audio-title">Controles de audio</h2></div><button class="modal-close" id="audio-close" aria-label="Cerrar">×</button></div><p class="audio-intro">Ajusta por separado los efectos de PseudoQuest y la banda sonora de las misiones.</p><div class="audio-setting"><div><span>🔔</span><div><b>Efectos del juego</b><small>Respuestas, logros y avisos</small></div><output data-sound-output>100%</output></div><input id="sound-volume" type="range" min="0" max="100" step="1" aria-label="Volumen de efectos"></div><div class="audio-setting"><div><span>♫</span><div><b>Música</b><small>Banda sonora durante una misión</small></div><output data-music-output>35%</output></div><input id="music-volume-global" type="range" min="0" max="100" step="1" aria-label="Volumen de música"></div><div class="audio-actions"><button class="button secondary" id="audio-mute">Silenciar todo</button><button class="button" id="music-next-global">Cambiar pista</button></div><small class="audio-note" data-audio-note>La opción de cambiar pista estará disponible durante una misión activa.</small></dialog>
<dialog class="profile-modal" id="profile-setup" aria-labelledby="profile-title"><div class="profile-emblem">K</div><p class="eyebrow">Registro de identidad local</p><h2 id="profile-title">Identifica al Reconstructor</h2><p>Tu identidad y progreso se guardarán únicamente en este navegador. Ningún dato abandona esta terminal.</p><form id="profile-form"><label>Nombre completo<input name="name" autocomplete="name" minlength="2" maxlength="40" required placeholder="Ej. Ana López"></label><label>Alias de Reconstructor<input name="alias" autocomplete="nickname" minlength="2" maxlength="24" required placeholder="Ej. ByteNinja"></label><small>El nombre quedará fijo. Podrás cambiar el alias desde Reconstrucción.</small><button class="button" type="submit">AUTORIZAR IDENTIDAD →</button></form></dialog>
<dialog class="profile-modal welcome-modal" id="profile-welcome" aria-labelledby="welcome-title"><div class="welcome-orbit" aria-hidden="true"><i></i><b>K</b></div><p class="eyebrow">IDENTIDAD AUTORIZADA // ENLACE ESTABLE</p><h2 id="welcome-title">Bienvenido, <span data-welcome-alias>Reconstructor</span></h2><p><strong data-welcome-name></strong>, el Archivo Kepler reconoce tu firma. Tu primera misión de reconstrucción ya está disponible.</p><div class="welcome-code">RECONSTRUCTOR STATUS <b>ACTIVE</b></div><button class="button" id="welcome-enter">ENTRAR AL CENTRO DE OPERACIONES →</button></dialog>
<aside class="badge-unlock" id="badge-unlock" role="status" aria-live="polite"><span>◇</span><div><small>Nueva distinción</small><b>Protocolo desbloqueado</b><small></small></div></aside>
<dialog class="kepler-intro" id="kepler-intro" aria-labelledby="kepler-intro-title" data-scene="boot"><div class="intro-grid" aria-hidden="true"></div><div class="intro-cosmos" aria-hidden="true"><i class="story-earth"><b></b></i><i class="story-kepler"><b></b></i><span class="story-route"></span><span class="cryo-pod">HIBERNATION<br><b>STABLE</b></span><svg class="kepler-vessel intro-vessel" viewBox="0 0 180 72"><path class="vessel-trail" d="M4 38h72"/><path class="vessel-hull" d="M70 36 119 13l45 23-45 23z"/><path class="vessel-wing" d="m105 27 7-23 15 24M105 45l7 23 15-24"/><circle cx="143" cy="36" r="5"/></svg></div><button class="intro-skip" id="intro-skip">OMITIR INTRO</button><div class="intro-console"><div class="intro-status"><i></i> ARCHIVE LINK // ONLINE <span data-intro-chapter>00 // BOOT</span></div><p class="intro-kicker">KEPLER ARCHIVE SYSTEM</p><h1 id="kepler-intro-title" data-intro-title>Inicializando...</h1><p class="intro-copy" data-intro-copy></p><div class="intro-progress"><span data-intro-progress></span></div><button class="button intro-start" id="intro-start" hidden>ACEPTAR ASIGNACIÓN →</button></div></dialog>
<div id="toast" class="toast" role="status" aria-live="polite"></div><script is:inline define:vars={{base}}>window.PQ_BASE=base;</script><script is:inline src={url('/app.js')}></script>
</body></html>
